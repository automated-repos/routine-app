# من Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# GitHub Pages بس: اسم الريبو بشرطة في الأول (مثال: /routine-app). على Netlify سيبيه فاضي
NEXT_PUBLIC_BASE_PATH=

# اختياري: الدومين اللي بيتحط بعد اسم المستخدم في الإيميل الداخلي (محدش بيشوفه)
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=routine.local
